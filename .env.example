# ── Frontend (Next.js) ───────────────────────────────────────────────
# The dashboard renders entirely from React Server Components and talks to
# Supabase server-side using the SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY
# defined in the backend section below — there is no browser Supabase client.
# FastAPI backend base URL
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
# Secret used to sign the dashboard session cookie (Next.js). Required in production.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=change_me_to_a_long_random_string

# ── Backend (FastAPI / agents) ────────────────────────────────────────
# Same project URL, server-side only.
SUPABASE_URL=your_supabase_project_url
# Secret, server-only: Dashboard → Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# Direct Postgres URI: Dashboard → Database → Connection string → URI
DATABASE_URL=postgresql://postgres:your_password@db.your_project_ref.supabase.co:5432/postgres

# ── Ollama (local LLM for agents) ───────────────────────────────────
# Run locally: `ollama pull qwen2.5:7b`, then `ollama serve` (or the desktop app).
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
# Embedding model for support-agent RAG (`ollama pull nomic-embed-text`), 768-dim.
EMBEDDING_MODEL=nomic-embed-text

# ── Orchestrator scheduler ─────────────────────────────────────────
# When enabled, the backend runs one full agent cycle every
# ORCHESTRATOR_INTERVAL_MINUTES — this is what makes the agents "autonomous".
# Keep it false for local dev (so runs don't fire while you work); set it to
# true in the deployed environment. The /dashboard/agents page shows the
# current state and the last cycle time.
SCHEDULER_ENABLED=false
ORCHESTRATOR_INTERVAL_MINUTES=10

# ── Langfuse (LLM observability, cloud.langfuse.com free tier) ─────────
# Sign up free at https://cloud.langfuse.com, create a project, copy keys.
# Optional: if unset, agents run normally with tracing silently disabled.
# Only PUBLIC_KEY + SECRET_KEY are read by the app (base.py `_langfuse_configured`);
# HOST and TRACING_ENVIRONMENT are consumed directly by the Langfuse SDK.
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com
# Tags every trace with the environment it ran in (dashboard filter);
# set to "production" on a real deployment.
LANGFUSE_TRACING_ENVIRONMENT=development
