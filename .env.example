# ── Frontend (Next.js) ───────────────────────────────────────────────
# Project URL: Dashboard → Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
# Publishable key: Dashboard → Settings → API (NOT the service_role key)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_key
# FastAPI backend base URL
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Backend (FastAPI / agents) ────────────────────────────────────────
# Same project URL, server-side only.
SUPABASE_URL=your_supabase_project_url
# Secret, server-only: Dashboard → Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# Direct Postgres URI: Dashboard → Database → Connection string → URI
DATABASE_URL=postgresql://postgres:your_password@db.your_project_ref.supabase.co:5432/postgres
