# ── Frontend (Next.js) ───────────────────────────────────────────────
# Project URL: Dashboard → Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
# Publishable key: Dashboard → Settings → API (NOT the service_role key)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_key
# FastAPI backend base URL
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
# Secret used to sign the dashboard session cookie (Next.js). Required in production.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=change_me_to_a_long_random_string

# ── Backend (FastAPI / agents) ────────────────────────────────────────
# Same project URL, server-side only.
SUPABASE_URL=your_supabase_project_url
# Secret, server-only: Dashboard → Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# Direct Postgres URI: Dashboard → Database → Connection string → URI
DATABASE_URL=postgresql://postgres:your_password@db.your_project_ref.supabase.co:5432/postgres

# ── Ollama (local LLM for agents) ───────────────────────────────────
# Run locally: `ollama pull qwen2.5:7b`, then `ollama serve` (or the desktop app).
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
# Embedding model for support-agent RAG (`ollama pull nomic-embed-text`), 768-dim.
EMBEDDING_MODEL=nomic-embed-text

# ── Orchestrator scheduler (optional) ───────────────────────────────
# When enabled, the backend runs one full agent cycle on this interval.
# Leave disabled for manual "Run full cycle" only.
SCHEDULER_ENABLED=false
ORCHESTRATOR_INTERVAL_MINUTES=10

# ── Langfuse (LLM observability, cloud.langfuse.com free tier) ─────────
# Sign up free at https://cloud.langfuse.com, create a project, copy keys.
# Optional: if unset, agents run normally with tracing silently disabled.
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# Tags every trace with the environment it ran in (dashboard filter);
# set to "production" on a real deployment.
LANGFUSE_TRACING_ENVIRONMENT=development
